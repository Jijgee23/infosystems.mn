# Postgres connection
DATA_BASE_URL="postgres://postgres:PASSWORD@localhost:5432/infosystems"

# Public site URL (used in emails, sitemap, metadata)
SITE_URL="http://localhost:3000"

# Session signing key for the portal/admin (32+ random chars): openssl rand -base64 48
AUTH_SECRET=""
# Signing key for desktop-app license tokens (/api/auth/local); falls back to AUTH_SECRET
LICENSE_JWT_SECRET=""

# SMTP (leave SMTP_HOST empty in dev: emails are logged instead of sent)
SMTP_HOST="mail.infosystems.mn"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
FROM_EMAIL="contact@infosystems.mn"
# Where form submissions / new issues are sent
NOTIFY_EMAIL="contact@infosystems.mn"

# Uploaded files (default: ./storage/uploads)
# UPLOAD_DIR="/var/www/infosystems/uploads"
# Issue attachments; must not be inside UPLOAD_DIR or exposed by nginx.
# PRIVATE_UPLOAD_DIR="/var/www/infosystems/private"
